# Dependencies
node_modules/

# Docusaurus production build & generated cache
/my-website/build
/my-website/.docusaurus
.cache-loader

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (readme_parser.py) — bytecode, caches, and the uv virtualenv
__pycache__/
*.py[cod]
.venv/
.python-version

# Data inputs (release-testing spreadsheets/CSVs are local-only, not committed).
# Covers my-website/Release.csv, the release-testing manifest.
*.csv
*.xlsx
*.xls

# icicle-release shared run directory (per-release working state: brief, bundles,
# README cache, manifest — kept locally between runs for skip-if-unchanged)
.release-run/

# OS / editor cruft
.DS_Store
.claude/skills/icicle-release/*
# Claude Code: ignore per-user local settings, but keep shared
# project config and skills (.claude/settings.json, .claude/skills/) tracked
.claude/settings.local.json
RELEASE_PROCESS.md

# Local-only reference docs (not part of the published site)
AGENT_ARCHITECTURE.html

# Release-notes drafts and their template (icicle-release-notes skill).
# These are reviewed and published to the website / mailing list, not committed here.
# The glob covers both ICICLE-Release-Template.md and ICICLE-Release-<YYYY-MM>.md.
ICICLE-Release-*.md